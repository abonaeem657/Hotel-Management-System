@{
    ViewData["Title"] = "Access denied";
}
@section Styles {
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
}
<div class="customer-page py-5">
    <div class="stay-empty p-4 p-md-5 text-center">
        <p class="stay-eyebrow">Access denied</p>
        <h1 class="h2">This page isn't available to your account.</h1>
        <p class="text-muted">You can continue browsing rooms or return to the home page.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-controller="CustomerRooms" asp-action="Index" class="btn btn-dark">Explore rooms</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Home</a>
        </div>
    </div>
</div>

@model IEnumerable<hotel.Models.Room>

@{
    var availableServices = ViewData["AvailableServices"] as IEnumerable<hotel.Models.RoomService>
        ?? Enumerable.Empty<hotel.Models.RoomService>();
}

<div id="room-management-modals" data-index-url="@Url.Action("Index", "Rooms")">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    <div class="modal fade" id="createRoomModal" tabindex="-1" aria-labelledby="createRoomModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form asp-action="Create" method="post" asp-antiforgery="true" class="room-management-form">
                    <input type="hidden" name="modalRequest" value="true" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="createRoomModalLabel">Add New Room</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none room-management-errors" role="alert"></div>
                        <div class="mb-3">
                            <label for="CreateRoomNumber" class="form-label">Room Number</label>
                            <input id="CreateRoomNumber" name="RoomNumber" class="form-control" required maxlength="20" />
                        </div>
                        <div class="mb-3">
                            <label for="CreateRoomType" class="form-label">Room Type</label>
                            <input id="CreateRoomType" name="RoomType" class="form-control" required maxlength="50" />
                        </div>
                        <div class="mb-3">
                            <label for="CreateBasePricePerNight" class="form-label">Base Price Per Night</label>
                            <input id="CreateBasePricePerNight" name="BasePricePerNight" class="form-control" required inputmode="decimal" />
                        </div>
                        <div class="mb-3">
                            <label for="CreateDescription" class="form-label">Description</label>
                            <textarea id="CreateDescription" name="Description" class="form-control" rows="4" maxlength="1000"></textarea>
                        </div>
                        <div class="form-check mb-3">
                            <input id="CreateIsAvailable" name="IsAvailable" type="checkbox" value="true" checked class="form-check-input" />
                            <input type="hidden" name="IsAvailable" value="false" />
                            <label for="CreateIsAvailable" class="form-check-label">Is Available</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create Room</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @foreach (var room in Model)
    {
        <div class="modal fade" id="detailsRoomModal-@room.Id" tabindex="-1" aria-labelledby="detailsRoomModalLabel-@room.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="detailsRoomModalLabel-@room.Id">Room @room.RoomNumber Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <dl class="row">
                            <dt class="col-sm-4">Room Number</dt>
                            <dd class="col-sm-8">@room.RoomNumber</dd>
                            <dt class="col-sm-4">Room Type</dt>
                            <dd class="col-sm-8">@room.RoomType</dd>
                            <dt class="col-sm-4">Base Price Per Night</dt>
                            <dd class="col-sm-8">@room.BasePricePerNight</dd>
                            <dt class="col-sm-4">Description</dt>
                            <dd class="col-sm-8 preserve-lines">@(string.IsNullOrWhiteSpace(room.Description) ? "No description." : room.Description)</dd>
                            <dt class="col-sm-4">Availability</dt>
                            <dd class="col-sm-8"><span class="badge status-badge @(room.IsAvailable ? "status-available" : "status-unavailable")">@(room.IsAvailable ? "Available" : "Unavailable")</span></dd>
                        </dl>
                        <h6>Room Services</h6>
                        @if (room.RoomServices.Any())
                        {
                            <ul>
                                @foreach (var service in room.RoomServices.OrderBy(s => s.ServiceName))
                                {
                                    <li>@service.ServiceName</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No services assigned.</p>
                        }
                        <h6>Room Images</h6>
                        @if (room.RoomImages.Any())
                        {
                            <div class="row g-3">
                                @foreach (var image in room.RoomImages)
                                {
                                    <div class="col-sm-6 col-lg-4">
                                        <img src="@image.ImagePath" class="img-fluid rounded room-admin-image" loading="lazy" alt="Room @room.RoomNumber" />
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No images have been uploaded for this room yet.</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="servicesRoomModal-@room.Id" tabindex="-1" aria-labelledby="servicesRoomModalLabel-@room.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <form asp-action="ManageServices" method="post" asp-antiforgery="true" class="room-management-form">
                        <input type="hidden" name="modalRequest" value="true" />
                        <input type="hidden" name="RoomId" value="@room.Id" />
                        <input type="hidden" name="RoomNumber" value="@room.RoomNumber" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="servicesRoomModalLabel-@room.Id">Services for Room @room.RoomNumber</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-danger d-none room-management-errors" role="alert"></div>
                            @foreach (var service in availableServices)
                            {
                                <div class="form-check mb-2">
                                    <input id="roomService-@room.Id-@service.Id" name="SelectedServiceIds" type="checkbox"
                                           value="@service.Id" checked="@room.RoomServices.Any(s => s.Id == service.Id)" class="form-check-input" />
                                    <label for="roomService-@room.Id-@service.Id" class="form-check-label">@service.ServiceName</label>
                                </div>
                            }
                            @if (!availableServices.Any())
                            {
                                <p class="text-muted">No room services are available.</p>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Services</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="imagesRoomModal-@room.Id" tabindex="-1" aria-labelledby="imagesRoomModalLabel-@room.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="imagesRoomModalLabel-@room.Id">Images for Room @room.RoomNumber</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none room-management-errors" role="alert"></div>
                        <form asp-action="UploadImage" method="post" enctype="multipart/form-data" asp-antiforgery="true"
                              class="room-management-form mb-4" data-reopen-modal="imagesRoomModal-@room.Id">
                            <input type="hidden" name="modalRequest" value="true" />
                            <input type="hidden" name="roomId" value="@room.Id" />
                            <div class="mb-3">
                                <label for="roomImageFile-@room.Id" class="form-label">Upload New Image</label>
                                <input id="roomImageFile-@room.Id" name="imageFile" type="file" class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp" aria-describedby="roomImageHelp-@room.Id" required />
                                <div id="roomImageHelp-@room.Id" class="form-text">JPG, JPEG, PNG or WEBP. Maximum 5 MB.</div>
                            </div>
                            <button type="submit" class="btn btn-primary">Upload Image</button>
                        </form>
                        <h6>Current Images</h6>
                        @if (room.RoomImages.Any())
                        {
                            <div class="row g-3">
                                @foreach (var image in room.RoomImages)
                                {
                                    <div class="col-md-4">
                                        <div class="card h-100">
                                            <img src="@image.ImagePath" class="card-img-top room-admin-image" loading="lazy"
                                                  alt="Room @room.RoomNumber" />
                                            <div class="card-body">
                                                <form asp-action="DeleteImage" method="post" asp-antiforgery="true"
                                                      class="room-management-form" data-reopen-modal="imagesRoomModal-@room.Id"
                                                      data-confirm="Are you sure you want to delete this image?">
                                                    <input type="hidden" name="modalRequest" value="true" />
                                                    <input type="hidden" name="roomId" value="@room.Id" />
                                                    <input type="hidden" name="imageId" value="@image.Id" />
                                                    <button type="submit" class="btn btn-danger btn-sm w-100">Delete Image</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No images have been uploaded for this room yet.</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteRoomModal-@room.Id" tabindex="-1" aria-labelledby="deleteRoomModalLabel-@room.Id" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <form asp-action="DeleteConfirmed" asp-route-id="@room.Id" method="post" asp-antiforgery="true" class="room-management-form">
                        <input type="hidden" name="modalRequest" value="true" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteRoomModalLabel-@room.Id">Delete Room</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-danger d-none room-management-errors" role="alert"></div>
                            <p>Are you sure you want to delete Room <strong>@room.RoomNumber</strong>?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

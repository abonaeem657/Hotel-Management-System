@model hotel.Models.Room

@{
    ViewData["Title"] = "Room Images";
}

<div class="container mt-4">

    <h2>Room Images</h2>

    <h5 class="mb-4">
        Room @Model.RoomNumber
    </h5>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Upload Image Form -->
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title">
                Upload New Image
            </h5>

            <form asp-action="UploadImage"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden"
                       name="roomId"
                       value="@Model.Id" />

                <div class="mb-3">

                    <label for="room-image-upload" class="form-label">
                        Select Image
                    </label>

                    <input id="room-image-upload" type="file"
                           name="imageFile"
                           class="form-control"
                           accept="image/*"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Upload Image
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>
    </div>


    <!-- Current Images -->
    <h4 class="mb-3">
        Current Images
    </h4>

    @if (Model.RoomImages != null && Model.RoomImages.Any())
    {
        <div class="row">

            @foreach (var image in Model.RoomImages)
            {
                <div class="col-md-4 col-lg-3 mb-4">

                    <div class="card h-100">

                        <img src="@image.ImagePath"
                             class="card-img-top room-admin-image"
                             
                             alt="Room @Model.RoomNumber" />

                        <div class="card-body">

                            <form asp-action="DeleteImage"
                                  method="post">

                                <input type="hidden"
                                       name="imageId"
                                       value="@image.Id" />

                                <input type="hidden"
                                       name="roomId"
                                       value="@Model.Id" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm w-100"
                                        onclick="return confirm('Are you sure you want to delete this image?')">

                                    Delete Image

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No images have been uploaded for this room yet.
        </div>
    }

</div>
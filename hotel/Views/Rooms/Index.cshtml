@model IEnumerable<hotel.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container mt-4">

    <div class="page-heading">
        <h2>Rooms Management</h2>

        <button type="button" class="btn btn-primary"
                data-bs-toggle="modal" data-bs-target="#createRoomModal">
            Add New Room
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state" role="status">No rooms to show. Add a room to get started.</div>
    }
    @if (Model.Any())
    {
    <div class="table-responsive" role="region" tabindex="0" aria-label="@ViewData["Title"] table">

        <table class="table table-bordered table-striped align-middle">

            <thead>
                <tr>
                    <th>Room Number</th>
                    <th>Room Type</th>
                    <th>Price Per Night</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var room in Model)
                {
                    <tr>

                        <td>
                            @room.RoomNumber
                        </td>

                        <td>
                            @room.RoomType
                        </td>

                        <td>
                            @room.BasePricePerNight
                        </td>

                        <td>
                            @if (room.IsAvailable)
                            {
                                <span class="badge status-badge status-available">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge status-badge status-unavailable">
                                    Unavailable
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-1 flex-wrap">

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editRoomModal-@room.Id">
                                    Edit
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#detailsRoomModal-@room.Id">
                                    Details
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#servicesRoomModal-@room.Id">
                                    Manage Services
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#imagesRoomModal-@room.Id">
                                    Images
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteRoomModal-@room.Id">
                                    Delete
                                </button>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
    }

</div>
@foreach (var room in Model)
{
    <div class="modal fade" id="editRoomModal-@room.Id" tabindex="-1"
         aria-labelledby="editRoomModalLabel-@room.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form asp-action="Edit" asp-route-id="@room.Id" method="post"
                      asp-antiforgery="true" class="room-edit-form">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editRoomModalLabel-@room.Id">Edit Room @room.RoomNumber</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Id" value="@room.Id" />
                        <input type="hidden" name="modalEdit" value="true" />
                        <div class="alert alert-danger d-none room-edit-errors" role="alert"></div>

                        <div class="mb-3">
                            <label for="RoomNumber-@room.Id" class="form-label">Room Number</label>
                            <input id="RoomNumber-@room.Id" name="RoomNumber" value="@room.RoomNumber"
                                   class="form-control" required maxlength="20" />
                        </div>
                        <div class="mb-3">
                            <label for="RoomType-@room.Id" class="form-label">Room Type</label>
                            <input id="RoomType-@room.Id" name="RoomType" value="@room.RoomType"
                                   class="form-control" required maxlength="50" />
                        </div>
                        <div class="mb-3">
                            <label for="BasePricePerNight-@room.Id" class="form-label">Base Price Per Night</label>
                            <input id="BasePricePerNight-@room.Id" name="BasePricePerNight"
                                   value="@room.BasePricePerNight" class="form-control" required inputmode="decimal" />
                        </div>
                        <div class="mb-3">
                            <label for="Description-@room.Id" class="form-label">Description</label>
                            <textarea id="Description-@room.Id" name="Description" class="form-control"
                                      rows="4" maxlength="1000">@room.Description</textarea>
                        </div>
                        <div class="form-check mb-3">
                            <input id="IsAvailable-@room.Id" name="IsAvailable" type="checkbox"
                                   value="true" checked="@room.IsAvailable" class="form-check-input" />
                            <input type="hidden" name="IsAvailable" value="false" />
                            <label for="IsAvailable-@room.Id" class="form-check-label">Is Available</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<partial name="_ManagementModals" model="Model" />

@section Scripts {
    <script src="~/js/rooms-management.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.room-edit-form').forEach(function (form) {
            const modal = form.closest('.modal');
            const errors = form.querySelector('.room-edit-errors');
            const saveButton = form.querySelector('button[type="submit"]');
            let saving = false;

            modal.addEventListener('hide.bs.modal', function (event) {
                if (saving) {
                    event.preventDefault();
                }
            });

            modal.addEventListener('hidden.bs.modal', function () {
                form.reset();
                errors.replaceChildren();
                errors.classList.add('d-none');
            });

            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                if (saving) {
                    return;
                }

                saving = true;
                saveButton.disabled = true;
                errors.replaceChildren();
                errors.classList.add('d-none');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form)
                    });

                    if (response.redirected && new URL(response.url).pathname.includes('/Account/')) {
                        window.location.assign(response.url);
                        return;
                    }

                    if (response.ok && response.redirected) {
                        window.location.assign('@Url.Action("Index", "Rooms")');
                        return;
                    }

                    let messages = ['Unable to save the room. Please try again.'];
                    if (response.status === 400 &&
                        (response.headers.get('content-type') || '').includes('application/json')) {
                        const result = await response.json();
                        if (Array.isArray(result.errors) && result.errors.length) {
                            messages = result.errors;
                        }
                    }

                    messages.forEach(function (message) {
                        const item = document.createElement('div');
                        item.textContent = message;
                        errors.appendChild(item);
                    });
                    errors.classList.remove('d-none');
                } catch {
                    errors.textContent = 'Unable to save the room. Check your connection and try again.';
                    errors.classList.remove('d-none');
                } finally {
                    saving = false;
                    saveButton.disabled = false;
                }
            });
        });
    </script>
}

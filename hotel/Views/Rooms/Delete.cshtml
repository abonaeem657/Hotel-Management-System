@model hotel.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4">

    <h2>Delete Room</h2>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

    <div class="alert alert-danger">
        Are you sure you want to delete this room?
    </div>

    <dl class="row">

        <dt class="col-sm-3">Room Number</dt>
        <dd class="col-sm-9">@Model.RoomNumber</dd>

        <dt class="col-sm-3">Room Type</dt>
        <dd class="col-sm-9">@Model.RoomType</dd>

        <dt class="col-sm-3">Price Per Night</dt>
        <dd class="col-sm-9">@Model.BasePricePerNight</dd>

    </dl>

    <form asp-action="DeleteConfirmed"
          asp-route-id="@Model.Id"
          method="post">

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

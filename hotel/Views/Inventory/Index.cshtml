@model IReadOnlyList<hotel.Models.Inventory>
@{ ViewData["Title"] = "Inventory"; }
<h1>Inventory</h1>
<p class="page-intro">Track supplies and see when stock needs attention.</p>
<partial name="_ManagementFeedback" />
<a asp-action="Create" class="btn btn-primary mb-3">Add item</a>
@if (!Model.Any())
{
    <div class="empty-state" role="status">No inventory to show.</div>
}
else
{
    <div class="table-responsive" role="region" tabindex="0" aria-label="@ViewData["Title"] table"><table class="table table-striped align-middle">
        <thead><tr><th>Item name</th><th>Current quantity</th><th>Reorder level</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.ItemName</td><td>@item.CurrentQuantity</td><td>@item.ReorderLevel</td>
            <td><span class="badge status-badge @(item.CurrentQuantity <= item.ReorderLevel ? "status-low" : "status-stock")">@(item.CurrentQuantity <= item.ReorderLevel ? "Low Stock" : "In Stock")</span></td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="UpdateQuantity" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Update quantity</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td></tr>
        }
        </tbody>
    </table></div>
}

@model hotel.Models.SeasonPricing
@{ ViewData["Title"] = "Delete Season Pricing"; }
<h1>@ViewData["Title"]</h1>
<p class="alert alert-warning">Confirm deletion of this record.</p>
<dl class="row">
    <dt class="col-sm-3">Season name</dt><dd class="col-sm-9">@Model.SeasonName</dd>
    <dt class="col-sm-3">Start date</dt><dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">End date</dt><dd class="col-sm-9">@Model.EndDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Price multiplier</dt><dd class="col-sm-9">@Model.PriceMultiplier</dd>
</dl>
<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

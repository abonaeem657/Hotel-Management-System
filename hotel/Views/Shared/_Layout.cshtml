@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAdmin = User.IsInRole("Admin");
    var management = isAdmin && (new[] { "Admin", "Rooms", "RoomServices", "SeasonPricing", "Offers", "Inventory", "Inbox" }.Contains(controller)
        || controller == "Bookings" && action != "MyBookings" && action != "Create");
    var adminLinks = new[] { ("Admin", "Dashboard"), ("Rooms", "Rooms Management"), ("RoomServices", "Room Services"),
        ("Bookings", "Bookings"), ("SeasonPricing", "Season Pricing"), ("Offers", "Offers"), ("Inventory", "Inventory"), ("Inbox", "Inbox") };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#182d3b" />
    <title>@ViewData["Title"] - Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isAdmin)
    {
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(management ? "admin-page" : "guest-page")">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark hotel-navbar" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">H</span> Hotel</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle main navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav mx-lg-auto">
                        @foreach (var link in new[] { ("Home", "Home"), ("CustomerRooms", "Rooms"), ("Contact", "Contact") })
                        {
                            <li class="nav-item"><a class="nav-link @(controller == link.Item1 ? "active" : "")"
                                aria-current="@(controller == link.Item1 ? "page" : null)" asp-controller="@link.Item1" asp-action="Index">@link.Item2</a></li>
                        }
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item"><a class="nav-link @(controller == "Bookings" && action == "MyBookings" ? "active" : "")"
                                asp-controller="Bookings" asp-action="MyBookings">My Bookings</a></li>
                        }
                    </ul>
                    <div class="account-menu">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="account-name"><span class="visually-hidden">Signed in as </span>@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="true" class="mb-0">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-gold btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    @if (isAdmin)
    {
        <div class="admin-nav">
            <nav class="navbar navbar-expand-xl navbar-light container" aria-label="Administration">
                <span class="admin-nav-label d-xl-none">Hotel administration</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavigation"
                        aria-controls="adminNavigation" aria-expanded="false" aria-label="Toggle administration navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="adminNavigation">
                    <ul class="navbar-nav gap-xl-1">
                        @foreach (var link in adminLinks)
                        {
                            <li class="nav-item"><a class="nav-link @(management && controller == link.Item1 ? "active" : "")"
                                aria-current="@(management && controller == link.Item1 ? "page" : null)"
                                asp-controller="@link.Item1" asp-action="Index">@link.Item2</a></li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    }
    <main id="main-content" tabindex="-1" class="container site-main @(management ? "admin-main" : "")">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container"><span>&copy; @DateTime.Now.Year Hotel</span>
            <div class="d-flex gap-3"><a asp-controller="CustomerRooms" asp-action="Index">Rooms</a><a asp-controller="Contact" asp-action="Index">Contact</a><a asp-controller="Home" asp-action="Privacy">Privacy</a></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


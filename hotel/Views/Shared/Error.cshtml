@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="surface">
    <p class="eyebrow">We could not complete that request</p>
    <h1>Something went wrong.</h1>
    <p class="text-muted">Please try again. If the problem continues, contact the hotel and include the reference below.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
        <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-primary">Contact Us</a>
    </div>
</section>


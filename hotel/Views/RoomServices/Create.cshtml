@model hotel.Models.RoomService

@{
    ViewData["Title"] = "Add Service";
}

<div class="container mt-4">

    <h2>Add New Service</h2>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="ServiceName" class="form-label">Service name (required)</label>

            <input asp-for="ServiceName"
                   class="form-control"
                   placeholder="Example: Wi-Fi" />

            <span asp-validation-for="ServiceName"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Service
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
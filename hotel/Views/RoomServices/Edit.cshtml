@model hotel.Models.RoomService

@{
    ViewData["Title"] = "Edit Service";
}

<div class="container mt-4">

    <h2>Edit Service</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="ServiceName" class="form-label">Service name (required)</label>

            <input asp-for="ServiceName"
                   class="form-control" />

            <span asp-validation-for="ServiceName"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>